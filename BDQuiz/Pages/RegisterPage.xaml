<Page x:Class="BDQuiz.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация">

    <Grid Background="{StaticResource BackgroundColor}">
        <Border Background="White" Width="350" Height="450" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Регистрация" Style="{StaticResource HeaderStyle}" Margin="0,0,0,20"/>
                <TextBlock Text="Логин:" Margin="0,5"/>
                <TextBox x:Name="TxtLogin" Padding="5"/>
                <TextBlock Text="Email:" Margin="0,5"/>
                <TextBox x:Name="TxtEmail" Padding="5"/>
                <TextBlock Text="Пароль:" Margin="0,5"/>
                <PasswordBox x:Name="PboxPassword" Padding="5"/>
                <StackPanel Orientation="Horizontal" Margin="0,5"/>
                <Button Content="Зарегистрироваться" Click="BtnReg_Click" Margin="0,20,0,5"/>
                <Button Content="Назад ко входу" Click="BtnBack_Click" Background="Gray"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
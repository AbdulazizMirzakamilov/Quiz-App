<Page x:Class="BDQuiz.Pages.QuizListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BDQuiz.Pages"
      mc:Ignorable="d" 
      Title="Список викторин" d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Доступные викторины" Style="{StaticResource HeaderStyle}" Margin="20"/>
        <Border Grid.Row="1" Margin="20,10,20,10" Background="White" CornerRadius="8" Padding="10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.1" BlurRadius="10"/>
            </Border.Effect>
            <ListBox 
                x:Name="QuizzesList" FontSize="18" Background="Transparent" BorderThickness="0" SelectionChanged="QuizzesList_SelectionChanged">
            </ListBox>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="Начать" Name="BtnStart" Click="BtnStart_Click"/>
            <Button Content="Создать" Name="BtnCreate" Click="BtnCreate_Click"/>
            <Button Content="Редактировать" x:Name="BtnEdit" Click="BtnEdit_Click"/>
            <Button Content="Удалить" x:Name="BtnDelete" Click="BtnDelete_Click" Background="Red" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>

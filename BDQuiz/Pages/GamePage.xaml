<Page x:Class="BDQuiz.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BDQuiz.Pages"
      mc:Ignorable="d" 
      Title="Прохождение викторины" d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtQuizTitle" Text="Название активной викторины" Style="{StaticResource HeaderStyle}" Margin="20"/>
        <Border Grid.Row="1" Margin="20,10,20,10" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.1" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtQuestion" Text="Вопрос" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,20"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AnswersPanel">
                        <RadioButton Content="Вариант 1"/>
                        <RadioButton Content="Вариант 2"/>
                        <RadioButton Content="Вариант 3"/>
                        <RadioButton Content="Вариант 4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="Меню" Background="Gray" Click="BtnMenu_Click"/>
            <Button Content="Ответить / Далее" x:Name="BtnNext" Click="BtnNext_Click"/>
        </StackPanel>
    </Grid>
</Page>

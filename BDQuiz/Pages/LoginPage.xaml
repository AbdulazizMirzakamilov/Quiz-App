<Page x:Class="BDQuiz.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход">

    <Grid Background="{StaticResource BackgroundColor}">
        <Border Background="White" Width="300" Height="350" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Вход в систему" Style="{StaticResource HeaderStyle}" Margin="0,0,0,20"/>
                <TextBlock Text="Логин:" Margin="0,5"/>
                <TextBox x:Name="TxtLogin" Padding="5"/>
                <TextBlock Text="Пароль:" Margin="0,5"/>
                <PasswordBox x:Name="PboxPassword" Padding="5"/>
                <Button Content="Войти" Click="BtnEnter_Click" Margin="0,20,0,5"/>
                <Button Content="Регистрация" Click="BtnReg_Click" Background="{StaticResource AccentColor}" Foreground="Black"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
<Page x:Class="BDQuiz.Pages.EditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Редактор викторин"
      d:DesignHeight="650" d:DesignWidth="1000">
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Создание / Редактирование викторины" Style="{StaticResource HeaderStyle}" Margin="20"/>
        <Border Grid.Row="1" Margin="20,10,20,10" Background="White" CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.1" BlurRadius="10"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Название викторины:" FontSize="18" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtQuizTitle" Margin="0,5,0,20" Padding="5" FontSize="16"/>
                    <TextBlock Text="Список вопросов:" FontSize="18" FontWeight="SemiBold"/>
                    <ListBox x:Name="QuestionsList" Height="300" Margin="0,5,0,10" Padding="5" SelectionChanged="QuestionsList_SelectionChanged">
                    </ListBox>
                    <Button Content="Добавить новый вопрос" x:Name="BtnAddQuestion" Background="{StaticResource AccentColor}" Foreground="{StaticResource TextColor}" Click="BtnAddQuestion_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Текст вопроса:" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtQuestionText" Margin="0,5,0,15" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>
                        <TextBlock Text="Варианты ответов:" FontSize="18" FontWeight="SemiBold"/>
                        <StackPanel x:Name="AnswersContainer" Margin="0,5,0,15">
                            <TextBlock Text="* Отметьте единственно правильный ответ" Foreground="Gray" FontSize="14" Margin="0,0,0,10"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkCorrect1" Margin="5,0,15,0" VerticalAlignment="Center" ToolTip="Это правильный ответ?"/>
                                <TextBox x:Name="TxtAnswer1" Grid.Column="1" Padding="5"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkCorrect2" Margin="5,0,15,0" VerticalAlignment="Center" ToolTip="Это правильный ответ?"/>
                                <TextBox x:Name="TxtAnswer2" Grid.Column="1" Padding="5"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkCorrect3" Margin="5,0,15,0" VerticalAlignment="Center" ToolTip="Это правильный ответ?"/>
                                <TextBox x:Name="TxtAnswer3" Grid.Column="1" Padding="5"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkCorrect4" Margin="5,0,15,0" VerticalAlignment="Center" ToolTip="Это правильный ответ?"/>
                                <TextBox x:Name="TxtAnswer4" Grid.Column="1" Padding="5"/>
                            </Grid>
                        </StackPanel>
                        <Button Content="Сохранить вопрос" x:Name="BtnSaveQuestion" Click="BtnSaveQuestion_Click" Width="175"/>
                        <Button Content="Удалить вопрос" x:Name="BtnDeleteQuestion" Background="#E53935" Margin="0,5,0,0" Click="BtnDeleteQuestion_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="Сохранить викторину в БД" x:Name="BtnSaveQuiz" Click="BtnSaveQuiz_Click" Width="210"/>
            <Button Content="Вернуться в Меню" Background="Gray" Click="BtnMenu_Click" Width="210"/>
        </StackPanel>
    </Grid>
</Page>